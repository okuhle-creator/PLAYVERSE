# ==============================================================================
# GLITCH HUNT: SIGNAL BREACH — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Connection (PostgreSQL)
# Compatible with Neon, Vercel Postgres, Supabase, or any managed PostgreSQL instance.
# Example: postgresql://username:password@ep-cool-frost-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/glitchhunt

# Optional: Override game round time limit in milliseconds (Default: 60000 = 60s)
GAME_ROUND_TIME_LIMIT_MS=60000

# Optional: Node environment
NODE_ENV=development

# Optional: Base API URL for frontend (leave blank or empty for relative '/api' in same-origin Vercel deployment)
VITE_API_BASE_URL=
